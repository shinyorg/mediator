<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>UnitTests</AssemblyName>
        <ShinyMediatorOpenApiPolymorphism>true</ShinyMediatorOpenApiPolymorphism>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
        <PackageReference Include="DryIoc.Microsoft.DependencyInjection"/>
        <PackageReference Include="GitHubActionsTestLogger">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Data.Sqlite"/>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="Microsoft.Extensions.Configuration"/>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="MartinCostello.Logging.XUnit"/>
        <PackageReference Include="Npgsql"/>
        <PackageReference Include="Shouldly"/>
        <PackageReference Include="Verify.SourceGenerators"/>
        <PackageReference Include="Verify.Xunit"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.Mediator.AppFunctions\Shiny.Mediator.AppFunctions.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Mediator.AspNet\Shiny.Mediator.AspNet.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Mediator.Blazor\Shiny.Mediator.Blazor.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Mediator.Caching.MicrosoftMemoryCache\Shiny.Mediator.Caching.MicrosoftMemoryCache.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Mediator.DapperRequests\Shiny.Mediator.DapperRequests.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Mediator.FluentValidation\Shiny.Mediator.FluentValidation.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Mediator\Shiny.Mediator.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Mediator.AppSupport\Shiny.Mediator.AppSupport.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Mediator.TickerQ\Shiny.Mediator.TickerQ.csproj"/>

        <ProjectReference Include="..\..\src\Shiny.Mediator.Contracts.SourceGenerators\Shiny.Mediator.Contracts.SourceGenerators.csproj"
                          OutputItemType="Analyzer"/>

        <ProjectReference Include="..\..\src\Shiny.Mediator.SourceGenerators\Shiny.Mediator.SourceGenerators.csproj"
                          OutputItemType="Analyzer"/>

        <ProjectReference Include="..\..\src\Shiny.Mediator.AspNet.SourceGenerators\Shiny.Mediator.AspNet.SourceGenerators.csproj"
                          OutputItemType="Analyzer"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Http\*.yml"/>
        <Content Include="SourceGeneration\*.yml" CopyToOutputDirectory="Always"/>
        <None Remove="SourceGeneration\*.json"/>
        <Content Include="SourceGeneration\*.json" CopyToOutputDirectory="Always"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Pin the compiled contracts to the reviewed fixture. The public spec can change
             operation IDs independently of these tests. Separate paths carry separate namespaces. -->
        <MediatorHttp Include="$(BaseIntermediateOutputPath)OpenApiFixtures/ThemeParksApi.yml"
                      Namespace="ThemeParksApi"
                      ContractPostfix="HttpRequest"
                      GenerateJsonConverters="false"
                      Visible="false"/>

        <MediatorHttp Include="$(BaseIntermediateOutputPath)OpenApiFixtures/ThemeParksApiGenerated.yml"
                      Namespace="ThemeParksApiGenerated"
                      ContractPostfix="HttpRequest"
                      GenerateJsonConverters="true"
                      Visible="false"/>

        <MediatorHttp Include="SourceGeneration\enums.json"
                      Namespace="EnumsApi"
                      ContractPostfix="HttpRequest"
                      GenerateJsonConverters="true"
                      Visible="false"/>

        <MediatorHttp Include="SourceGeneration\polymorphism.json"
                      Namespace="PolymorphicApi"
                      GenerateModelsOnly="true"
                      GenerateJsonConverters="true"
                      Visible="false"/>
    </ItemGroup>

    <Target Name="PrepareOpenApiTestFixtures" BeforeTargets="_InjectShinyMediatorAdditionalFiles">
        <Copy SourceFiles="SourceGeneration/themeparksapi-v1.17.yml"
              DestinationFiles="$(BaseIntermediateOutputPath)OpenApiFixtures/ThemeParksApi.yml" />
        <Copy SourceFiles="SourceGeneration/themeparksapi-v1.17.yml"
              DestinationFiles="$(BaseIntermediateOutputPath)OpenApiFixtures/ThemeParksApiGenerated.yml" />
    </Target>

    <Import Project="..\..\src\Shiny.Mediator.SourceGenerators\SourceGenerators.targets"/>
</Project>
