{
  "openapi": "3.0.0",
  "info": { "title": "Zoo", "version": "1.0" },
  "paths": {
    "/animals": {
      "get": {
        "operationId": "getAnimals",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Zoo" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Zoo": {
        "type": "object",
        "properties": {
          "animals": { "type": "array", "items": { "$ref": "#/components/schemas/Animal" } }
        }
      },
      "Animal": {
        "type": "object",
        "x-abstract": true,
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "dog": "#/components/schemas/Dog",
            "puppy": "#/components/schemas/Puppy"
          }
        },
        "required": [ "kind" ],
        "properties": {
          "kind": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "Dog": {
        "allOf": [
          { "$ref": "#/components/schemas/Animal" },
          {
            "type": "object",
            "properties": {
              "breed": { "type": "string" }
            }
          }
        ]
      },
      "Puppy": {
        "allOf": [
          { "$ref": "#/components/schemas/Dog" },
          {
            "type": "object",
            "properties": {
              "ageInWeeks": { "type": "integer", "format": "int32" }
            }
          }
        ]
      },
      "Cat": {
        "allOf": [
          { "$ref": "#/components/schemas/Animal" },
          {
            "type": "object",
            "properties": {
              "lives": { "type": "integer", "format": "int32" }
            }
          }
        ]
      }
    }
  }
}
