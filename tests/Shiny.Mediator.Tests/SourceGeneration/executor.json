{
  "openapi": "3.0.1",
  "info": { "title": "Executor", "version": "1.0" },
  "paths": {
    "/orders/{orderId}": {
      "get": {
        "operationId": "getOrder",
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderData" } } }
          }
        }
      }
    },
    "/orders/{orderId}/status": {
      "get": {
        "operationId": "getOrderStatus",
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderStatus" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrderStatus": { "type": "string", "enum": [ "Open", "Paid", "Voided" ] },
      "OrderData": {
        "type": "object",
        "properties": {
          "orderId": { "type": "string", "format": "uuid" },
          "status": { "$ref": "#/components/schemas/OrderStatus" }
        }
      }
    }
  }
}
