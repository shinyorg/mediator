<Project>
    <PropertyGroup>
        <MicrosoftSdkVersion>11.0.0</MicrosoftSdkVersion>
        <MauiVersion>11.0.10</MauiVersion>
        <AppFunctionsVersion>7.0.0</AppFunctionsVersion>
        <!-- TickerQ 10.5+ is source-available (not MIT); 11.x will not execute jobs without a license certificate -->
        <TickerQVersion>11.5.1</TickerQVersion>
    </PropertyGroup>
    <!-- net10 builds: the newest releases of these that still ship a net10 lib (later majors are net11 only) -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <AppFunctionsVersion>6.6.0</AppFunctionsVersion>
        <TickerQVersion>10.5.1</TickerQVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(MicrosoftSdkVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(MicrosoftSdkVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftSdkVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="$(MicrosoftSdkVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftSdkVersion)"/>
        <PackageVersion Include="Shiny.Extensions.DependencyInjection" Version="6.0.2"/>
        <PackageVersion Include="Shiny.Extensions.Serialization" Version="6.0.2"/>
        <PackageVersion Include="TickerQ" Version="$(TickerQVersion)"/>
        <PackageVersion Include="TickerQ.EntityFrameworkCore" Version="$(TickerQVersion)"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0"/>
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageVersion Include="Avalonia" Version="12.2.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(MicrosoftSdkVersion)"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(MicrosoftSdkVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Http" Version="$(MicrosoftSdkVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.AI" Version="11.0.1"/>
        <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="11.0.1"/>
        <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.1"/>
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="$(MicrosoftSdkVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Resilience" Version="11.0.1"/>
        <PackageVersion Include="Dapper" Version="2.1.100"/>
        <PackageVersion Include="InterpolatedSql.Dapper" Version="2.5.1"/>
        <PackageVersion Include="FluentValidation" Version="12.2.0"/>
        <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0"/>
        <PackageVersion Include="RabbitMQ.Client" Version="7.3.0"/>
        <PackageVersion Include="Sentry" Version="7.0.1"/>
        <PackageVersion Include="Shiny.AppFunctions" Version="$(AppFunctionsVersion)"/>
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="SharpYaml" Version="2.1.5"/>
        <PackageVersion Include="Microsoft.OpenApi" Version="3.11.1"/>
        <PackageVersion Include="Microsoft.OpenApi.YamlReader" Version="3.11.1"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0"/>
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageVersion Include="sqlite-net-pcl" Version="1.11.285"/>
        <PackageVersion Include="Scalar.AspNetCore" Version="3.2.0"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="$(MicrosoftSdkVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="$(MicrosoftSdkVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="$(MicrosoftSdkVersion)"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(MicrosoftSdkVersion)"/>
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8"/>
        <PackageVersion Include="DeviceRunners.UITesting.Maui" Version="0.1.0-preview.5"/>
        <PackageVersion Include="DeviceRunners.UITesting.Xunit" Version="0.1.0-preview.5"/>
        <PackageVersion Include="DeviceRunners.VisualRunners.Maui" Version="0.1.0-preview.5"/>
        <PackageVersion Include="DeviceRunners.VisualRunners.Xunit" Version="0.1.0-preview.5"/>
        <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5"/>
        <PackageVersion Include="DryIoc.Microsoft.DependencyInjection" Version="8.0.0"/>
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="$(MicrosoftSdkVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftSdkVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(MicrosoftSdkVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0"/>
        <PackageVersion Include="MartinCostello.Logging.XUnit" Version="0.7.1"/>
        <PackageVersion Include="Npgsql" Version="11.0.0"/>
        <PackageVersion Include="Shouldly" Version="4.3.0"/>
        <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0"/>
        <PackageVersion Include="Verify.Xunit" Version="31.12.5"/>
        <PackageVersion Include="xunit" Version="2.9.3"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1"/>
    </ItemGroup>
</Project>